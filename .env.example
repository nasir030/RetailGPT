# Copy this file to .env and adjust as needed.
# .env is gitignored - never commit real secrets.

# --- Ollama (local LLM) ---
# Default Ollama server address. Change only if you're running Ollama on a
# different host/port or in a container.
OLLAMA_HOST=http://localhost:11434

# Which local model to use. Pull it first with:
#   ollama pull mistral
#   ollama pull llama3.1:8b
OLLAMA_MODEL=mistral
# OLLAMA_MODEL=llama3.1:8b

# Seconds to wait for a model response before falling back to the templated answer
OLLAMA_TIMEOUT=60

# --- FastAPI backend ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Streamlit dashboard ---
STREAMLIT_PORT=8501
